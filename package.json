{
  "name": "deployguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:webhook": "node scripts/send-test-webhook.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node --experimental-strip-types scripts/verify-phase5.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:phase7": "node --experimental-strip-types scripts/verify-phase7.mjs",
    "verify:phase8": "node scripts/verify-phase8.mjs",
    "verify:phase9": "node scripts/verify-phase9.mjs",
    "audit": "npm audit --audit-level=high",
    "verify:redaction": "node scripts/verify-redaction.mjs",
    "verify:injection": "node scripts/verify-injection.mjs",
    "verify:csrf-and-auth": "node scripts/verify-csrf-and-auth.mjs",
    "verify:hindsight-canary": "node scripts/verify-hindsight-canary.mjs",
    "db:redact-existing": "node --experimental-strip-types scripts/redact-existing.mjs",
    "verify:queue": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/verify-queue.mjs",
    "verify:lifecycle": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/verify-lifecycle.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:dashboard": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/verify-dashboard.mjs",
    "eval:risk": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/evaluate-risk.mjs",
    "verify:learning": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/verify-learning.mjs",
    "verify:inputs": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/verify-inputs.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
