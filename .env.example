# TEMPLATE ONLY -- this file IS committed to git.
# Never put a real value in here. Copy it to .env.local and fill that in instead.
# (.env and .env.local are gitignored; .env.example is not.)

# --- GitHub webhook (Phase 1) ---
# Must match the Secret field of the webhook in GitHub repo Settings -> Webhooks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
# CI status reporting ONLY (GitHub Actions secret). Accepted only by POST /api/deployments/status.
DEPLOYGUARD_STATUS_TOKEN=your_deployguard_status_token
# Stage 1: internal maintenance/admin operations ONLY (maintenance run, backfill,
# verification scripts). Must differ from DEPLOYGUARD_STATUS_TOKEN. Server-only.
DEPLOYGUARD_INTERNAL_TOKEN=
# --- Database (Phase 2) ---
# Any PostgreSQL connection string. For Supabase use the CONNECTION POOLER string from
# Project Settings -> Database -> Connection string -> Transaction pooler.
# Example shape: postgresql://user:password@host:6543/postgres
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=supabase_publishable_key
SUPABASE_SECRET_KEY=supabase_secret_key
DATABASE_URL=database_url

# --- Hindsight agent memory (Phase 2) ---
HINDSIGHT_API_KEY=hindsight_api_key
HINDSIGHT_BASE_URL=hindsight_base_url
# Memory bank that stores DeployGuard's deployment history. Defaults to DeployGuard.
HINDSIGHT_BANK_ID=hindsight_bank_id

# --- Gemini risk analysis (Phase 7) ---
GEMINI_API_KEY=gemini_api_key
# Optional. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- GitHub App: login + repository connection (Phase 9) ---
# From the GitHub App's settings page. The App's webhook secret must be the same
# value as GITHUB_WEBHOOK_SECRET above (one secret, one webhook endpoint).
GITHUB_APP_ID=github_app_id
GITHUB_APP_CLIENT_ID=github_app_client_id
GITHUB_APP_CLIENT_SECRET=github_app_client_secret
# Multi-line PEM in double quotes, or one line with \n escapes.
GITHUB_APP_PRIVATE_KEY="github_app_private_key"
# --- Stage 1: security (optional) ---
# Public origin of DeployGuard (e.g. https://deployguard.example.com). Used by the CSRF
# origin check when the app sits behind a proxy that rewrites the Host header.
# DEPLOYGUARD_BASE_URL=
# Number of trusted proxies that append to X-Forwarded-For (default 1).
# DEPLOYGUARD_TRUSTED_PROXY_HOPS=1

# --- Stage 2: cost control and data retention (optional) ---
# Gemini analyses per repository per day / per calendar month (defaults 50 / 500).
# DEPLOYGUARD_GEMINI_DAILY_CAP=50
# DEPLOYGUARD_GEMINI_MONTHLY_CAP=500
# Days to keep observed failure output (log tails); 0 = forever (default 90).
# DEPLOYGUARD_RETENTION_FAILURE_OUTPUT_DAYS=90
# Days to keep deployments at all (purged from PostgreSQL and Hindsight); 0 = forever (default 0).
# DEPLOYGUARD_RETENTION_DEPLOYMENT_DAYS=0

# --- Stage 4: learning (optional) ---
# Hours after a deployment in which a revert commit is attached to it (default 72; 0 = off).
# DEPLOYGUARD_REVERT_WINDOW_HOURS=72

# --- Stage 5: better inputs (optional) ---
# Advisory pull request check runs ("off" disables them everywhere; per repository use
# pull_request_checks: false in .deployguard.yml). Default on.
# DEPLOYGUARD_PR_CHECKS=on
